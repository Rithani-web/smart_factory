// Single source of truth for all data (Constitution IV).
// See specs/001-mvp-event-lifecycle/data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TECHNICIAN
  VIEWER
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventStatus {
  OPEN
  ASSIGNED
  ACKNOWLEDGED
  RESOLVED
}

enum NotificationStatus {
  SENT
  FAILED
}

enum HistoryAction {
  CREATED
  ASSIGNED
  REASSIGNED
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

enum RotationCadence {
  WEEKLY
  DAILY
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(VIEWER)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())

  reportedEvents       ProductionEvent[]  @relation("Reporter")
  resolvedEvents       ProductionEvent[]  @relation("Resolver")
  assignments          Assignment[]
  teamsLed             Team[]             @relation("TeamEscalationAdmin")
  teamMemberships      TeamMembership[]   @relation("TeamMemberships")
  statusMessages       StatusMessage[]    @relation("StatusMessages")
  notifications        Notification[]
  historyEntries       HistoryEntry[]
}

model ProductionEvent {
  id              String      @id @default(cuid())
  title           String
  description     String
  machineRef      String
  severity        Severity
  status          EventStatus @default(OPEN)
  reporterId      String
  reporter        User        @relation("Reporter", fields: [reporterId], references: [id])
  resolvedById    String?
  resolvedBy      User?       @relation("Resolver", fields: [resolvedById], references: [id])
  resolutionNotes String?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  createdAt       DateTime    @default(now())

  // spec/002 escalation state (research D13)
  ackDeadline    DateTime?
  escalationStep Int       @default(0)

  assignments   Assignment[]
  notifications Notification[]
  history       HistoryEntry[]

  @@index([status])
  @@index([createdAt])
}

model Assignment {
  id           String          @id @default(cuid())
  eventId      String
  event        ProductionEvent @relation(fields: [eventId], references: [id])
  technicianId String
  technician   User            @relation(fields: [technicianId], references: [id])
  assignedAt   DateTime        @default(now())
  active       Boolean         @default(true)

  @@index([eventId, active])
}

model Team {
  id                String          @id @default(cuid())
  name              String          @unique
  cadence           RotationCadence
  anchorAt          DateTime
  escalationAdminId String?
  escalationAdmin   User?           @relation("TeamEscalationAdmin", fields: [escalationAdminId], references: [id])
  createdAt         DateTime        @default(now())

  members        TeamMembership[]
  statusMessage  StatusMessage?

  @@index([createdAt])
}

model TeamMembership {
  id           String @id @default(cuid())
  teamId       String
  team         Team   @relation(fields: [teamId], references: [id])
  technicianId String
  technician   User   @relation("TeamMemberships", fields: [technicianId], references: [id])
  position     Int

  @@unique([teamId, technicianId])
  @@index([teamId, position])
}

model EscalationPolicy {
  severity      Severity @id
  windowMinutes Int?
}

model SlaTarget {
  severity       Severity @id
  ackMinutes     Int
  resolveMinutes Int
}

model StatusMessage {
  id        String   @id @default(cuid())
  teamId    String   @unique
  team      Team     @relation(fields: [teamId], references: [id])
  message   String
  authorId  String
  author    User     @relation("StatusMessages", fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Notification {
  id          String            @id @default(cuid())
  eventId     String
  event       ProductionEvent   @relation(fields: [eventId], references: [id])
  recipientId String
  recipient   User              @relation(fields: [recipientId], references: [id])
  channel     String            @default("email")
  status      NotificationStatus
  error       String?
  sentAt      DateTime          @default(now())

  @@index([eventId])
}

model HistoryEntry {
  id        String          @id @default(cuid())
  eventId   String
  event     ProductionEvent @relation(fields: [eventId], references: [id])
  action    HistoryAction
  actorId   String
  actor     User            @relation(fields: [actorId], references: [id])
  detail    String?
  createdAt DateTime        @default(now())

  @@index([eventId, createdAt])
}
